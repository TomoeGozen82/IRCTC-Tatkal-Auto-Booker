<Window x:Class="Booking.BookingConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Booking Configuration"
        Height="780"
        Width="980"
        MinHeight="680"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Text="Journey Details" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBox Grid.Row="1" Margin="0,0,8,8" Text="{Binding FromStation, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="From Station" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" Text="{Binding ToStation, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="To Station" />
                        <DatePicker Grid.Row="1" Grid.Column="2" SelectedDate="{Binding JourneyDate}" />
                        <ComboBox Grid.Row="2" Margin="0,0,8,0" ItemsSource="{Binding QuotaOptions}" SelectedItem="{Binding SelectedQuota}" materialDesign:HintAssist.Hint="Quota" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,0" Text="{Binding PreferredTrainNumbers, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Preferred Train Numbers" />
                        <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding ClassPriorityOptions}" SelectedItem="{Binding PreferredClassPriority}" materialDesign:HintAssist.Hint="Class Priority" />
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Margin="0,0,0,12" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="240" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Passenger Details" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Passengers}"
                                  SelectedItem="{Binding SelectedPassenger}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="Age" Binding="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Gender" Binding="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Berth Preference" Binding="{Binding BerthPreference, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Add Passenger" Margin="0,0,8,0" Command="{Binding AddPassengerCommand}" />
                            <Button Content="Remove Passenger" Command="{Binding RemovePassengerCommand}" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Margin="0,0,0,12" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Account Selection" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding AccountSelections}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Account.UserId}" />
                                        <TextBlock Grid.Column="2" Opacity="0.7" Text="{Binding Account.Status}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="3" Margin="0,0,0,12" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="Scheduler" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,8,0">
                            <DatePicker Width="160" SelectedDate="{Binding BookingStartDate}" />
                            <TextBox Width="120" Margin="8,0,0,0" Text="{Binding BookingStartTimeText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="HH:mm:ss" />
                        </StackPanel>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding WarmupTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Warmup Time (HH:mm:ss)" />
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="4" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="Captcha Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ComboBox Grid.Row="1" Margin="0,0,8,0" ItemsSource="{Binding CaptchaProviders}" SelectedItem="{Binding SelectedCaptchaProvider}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CaptchaApiKey, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Captcha API Key" />
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button Content="Start Automation"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding StartAutomationCommand}" />
        </StackPanel>
    </Grid>
</Window>
