<Window x:Class="Booking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="IRCTC Tatkal Auto Booker"
        Height="900"
        Width="1500"
        MinHeight="720"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    <Window.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Height="88"
                Padding="20,12"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="IRCTC Tatkal Auto Booker"
                               FontSize="28"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Margin="18,0,0,0"
                            Padding="10,4"
                            CornerRadius="12"
                            VerticalAlignment="Center"
                            Background="{Binding ConnectionStatusBrush}">
                        <TextBlock Foreground="White"
                                   FontWeight="Medium"
                                   Text="{Binding ConnectionStatusText}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimeDisplay}"
                               HorizontalAlignment="Center"
                               FontSize="30"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding TatkalTimingHint}"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignValidationErrorBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Start All"
                            Margin="0,0,8,0"
                            Command="{Binding StartAllCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="Stop All"
                            Margin="0,0,8,0"
                            Command="{Binding StopAllCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="16"
                    Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorderStyle}" Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="Active Accounts" Opacity="0.8" />
                                    <TextBlock Text="{Binding ActiveAccountsText}" FontSize="28" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Grid.Column="1">
                                <StackPanel>
                                    <TextBlock Text="Booking Profiles" Opacity="0.8" />
                                    <TextBlock Text="{Binding BookingProfiles.Count}" FontSize="28" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Grid.Column="2" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Active Jobs" Opacity="0.8" />
                                    <TextBlock Text="{Binding ActiveJobs.Count}" FontSize="28" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Accounts"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Accounts}"
                                          SelectedItem="{Binding SelectedAccount}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="1.6*" />
                                        <DataGridTextColumn Header="Password" Binding="{Binding PasswordDisplay}" Width="1.4*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                        <DataGridTextColumn Header="Proxy" Binding="{Binding Proxy}" Width="*" />
                                        <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginDisplay}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2"
                                           Margin="0,12,0,0"
                                           Opacity="0.7"
                                           Text="Manage accounts in the Accounts Manager tab." />
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Row="2" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="180" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="180" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Active Jobs"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding ActiveJobs}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="2*" />
                                        <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="2*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding RuntimeStatusText}" Width="*" />
                                        <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2" Text="Live Logs"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,8" />

                                <ListBox Grid.Row="3"
                                         ItemsSource="{Binding Logs}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedMessage}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                                <Setter Property="Foreground" Value="#4CAF50" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                                                <Setter Property="Foreground" Value="#FFC107" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                <Setter Property="Foreground" Value="#F44336" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Accounts Manager">
                    <Grid Margin="12">
                        <materialDesign:Card Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Accounts Manager" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding AccountItems}"
                                      SelectedItem="{Binding SelectedAccountItem}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="1.4*" />
                                    <DataGridTextColumn Header="Password" Binding="{Binding Password}" Width="1.4*" />
                                    <DataGridTextColumn Header="Session" Binding="{Binding SessionState}" Width="*" />
                                    <DataGridTextColumn Header="Proxy" Binding="{Binding Proxy}" Width="1.3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Book" Margin="0,0,8,0" Command="{Binding BookSelectedAccountCommand}" />
                                <Button Content="{Binding SelectedAccountActionButtonText}"
                                        Margin="0,0,8,0"
                                        Command="{Binding ToggleSelectedAccountActionCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedAccountActionRunning}" Value="True">
                                                    <Setter Property="Background" Value="#C62828" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Add New Account" Margin="0,0,8,0" Command="{Binding AddAccountCommand}" />
                                <Button Content="Edit" Margin="0,0,8,0" Command="{Binding EditAccountCommand}" />
                                <Button Content="Delete" Margin="0,0,8,0" Command="{Binding DeleteAccountCommand}" />
                            </StackPanel>
                        </Grid>
                        </materialDesign:Card>
                    </Grid>
            </TabItem>

            <TabItem Header="Booking Profiles">
                <Grid Margin="12">
                    <materialDesign:Card Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Booking Profiles" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding BookingProfiles}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="2*" />
                                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="2*" />
                                    <DataGridTextColumn Header="Train(s)" Binding="{Binding PreferredTrainNumbers}" Width="*" />
                                    <DataGridTextColumn Header="Class" Binding="{Binding ClassPriority}" Width="*" />
                                    <DataGridTextColumn Header="Passengers" Binding="{Binding PassengerCount}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <TabItem Header="Live Logs">
                <Grid Margin="12">
                    <materialDesign:Card Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Live Logs" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding Logs}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedMessage}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                                            <Setter Property="Foreground" Value="#4CAF50" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Info">
                                                            <Setter Property="Foreground" Value="#FFC107" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="#F44336" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
