<Window x:Class="Booking.BookingSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:booking="clr-namespace:Booking"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="760"
        Width="980"
        MinHeight="680"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <materialDesign:Card Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Text="Journey Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBox Grid.Row="1" Margin="0,0,8,8" Text="{Binding FromStation, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="From Station" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" Text="{Binding ToStation, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="To Station" />
                        <DatePicker Grid.Row="1" Grid.Column="2" SelectedDate="{Binding JourneyDate}" />

                        <ComboBox Grid.Row="2" Margin="0,0,8,0" ItemsSource="{Binding QuotaOptions}" SelectedItem="{Binding SelectedQuota}" materialDesign:HintAssist.Hint="Quota" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,0" Text="{Binding PreferredTrainNumbers, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Preferred Train Numbers" />
                        <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding ClassPriority}" materialDesign:HintAssist.Hint="Class Priority" />
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="240" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Passengers" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Passengers}"
                                  SelectedItem="{Binding SelectedPassenger}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="Age" Binding="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridComboBoxColumn Header="Gender" Width="*"
                                                        SelectedItemBinding="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{x:Static booking:PassengerFieldOptions.Genders}" />
                                <DataGridComboBoxColumn Header="Country" Width="1.4*"
                                                        SelectedItemBinding="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{x:Static booking:PassengerFieldOptions.Countries}" />
                                <DataGridComboBoxColumn Header="Berth" Width="1.2*"
                                                        SelectedItemBinding="{Binding Berth, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{x:Static booking:PassengerFieldOptions.Berths}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Add" Margin="0,0,8,0" Command="{Binding AddPassengerCommand}" />
                            <Button Content="Remove" Command="{Binding RemovePassengerCommand}" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="4" Text="Scheduler (Optional)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <CheckBox Grid.Row="1" Grid.ColumnSpan="4" Content="Enable Start Time" IsChecked="{Binding EnableScheduler}" />

                        <DatePicker Grid.Row="2" Grid.Column="1" Margin="0,10,8,0" SelectedDate="{Binding StartDate}" />
                        <TextBox Grid.Row="2" Grid.Column="3" Margin="0,10,0,0" Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="HH:mm:ss" />
                    </Grid>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button Content="{Binding SaveButtonText}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding StartBookingCommand}" />
        </StackPanel>
    </Grid>
</Window>

